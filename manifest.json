{
  "manifest_version": 3,
  "name": "ViperTab",
  "version": "1.4.2",
  "description": "A macOS-inspired new tab page with Apple Glass UI, widgets, dock, and spotlight search.",
  "author": "ViperShard",
  "permissions": [
    "tabs",
    "bookmarks",
    "sessions",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
